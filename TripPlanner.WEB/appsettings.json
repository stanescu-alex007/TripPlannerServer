{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Key": "",
    "Issuer": "TripPlanner",
    "Audience": "TripPlanner",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshFamilyDays": 30
  },

  "Email": {
