      "ApiKey": ""
    },
    "File": {
      "Directory": "../_sent-emails"
    }
  },

  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4300" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AllowedHosts": "*"
